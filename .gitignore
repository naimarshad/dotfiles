zsh/.kube/config*
zsh/.kube/configs/
niri/.config/niri/unsplash-key

# Claude Code local settings
.claude/
**/.claude/

# Decrypted SOPS output - only the .sops.* files belong in git.
noctalia/settings.toml

# tmux plugins are TPM-managed git clones, and themes/ holds Noctalia-generated
# output that nothing sources any more. Both paths appear inside the package
# when stow folds ~/.config/tmux into a symlink on a fresh checkout.
tmux/.config/tmux/plugins/
tmux/.config/tmux/themes/
