input {
    keyboard {
        xkb {
            layout "us"
        }
        repeat-delay 300
        repeat-rate 50
        numlock
    }

    mouse {
        accel-speed 0.0
        accel-profile "flat"
    }

    touchpad {
        tap
        natural-scroll
        scroll-factor 0.8
        click-method "clickfinger"
    }

    focus-follows-mouse max-scroll-amount="0%"
}
