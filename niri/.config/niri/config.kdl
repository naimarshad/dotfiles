// =====================================================================
// ~/.config/niri/config.kdl
// Niri Wayland Compositor Configuration
// Migrated from Hyprland
//
// niri is a scrollable-tiling compositor — windows live in infinite
// horizontal columns per workspace. There is no dwindle/master layout.
// Your Hyprland "scrolling" layout (workspaces 1, 6-7) is now universal.
//
// Migration deltas vs. Hyprland:
//   hyprctl reload         → reconfigure bind (Mod+Shift+R)
//   exec-once              → spawn-at-startup
//   layerrule blur         → Noctalia layer-shell blur auto-respected
//   noctalia-colors.conf   → not needed (static focus-ring colors used)
//   hyprshell tools        → removed (no equivalent; use Noctalia launcher)
//   Mod+L conflict         → resolved: Mod+L = lockScreen only
//   Mod+J conflict         → resolved: Mod+J = focus-down only
//   Mod+P pseudo           → repurposed: expel-window-from-column
//   hypridle dpms cmds     → see hypridle.conf in this package
//
// To deploy: stow -d ~/dotfiles -t $HOME niri
//            (unstow hypr first to avoid hypridle.conf conflict)
// =====================================================================

// Server-side decorations — compositor draws window chrome.
// Most GTK4/Qt6 apps honour this. Electron apps typically ignore it.
prefer-no-csd

// =====================================================================
// ENVIRONMENT VARIABLES
// Loaded before any window opens, equivalent to Hyprland's env.conf.
// HYPRCURSOR_* removed — not applicable outside Hyprland.
// =====================================================================
environment {
    GTK_THEME                       "adw-gtk3-dark"
    GDK_BACKEND                     "wayland,x11"
    QT_QPA_PLATFORM                 "wayland;xcb"
    SDL_VIDEODRIVER                 "wayland"
    CLUTTER_BACKEND                 "wayland"
    GDK_SCALE                       "1"
    GDK_DPI_SCALE                   "1"
    QT_SCALE_FACTOR                 "1"
    QT_FONT_DPI                     "109"
    QT_AUTO_SCREEN_SCALE_FACTOR     "1"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    QT_QPA_PLATFORMTHEME            "qt6ct"
    XCURSOR_THEME                   "Bibata-Modern-Amber"
    XCURSOR_SIZE                    "24"
    HYPRSHOT_DIR                    "/home/naeem/Pictures/Screenshots"
    XDG_CURRENT_DESKTOP             "niri"
    XDG_SESSION_TYPE                "wayland"
    XDG_SESSION_DESKTOP             "niri"
    ELECTRON_OZONE_PLATFORM_HINT    "wayland"
    _JAVA_AWT_WM_NONREPARENTING     "1"
    AWT_TOOLKIT                     "MToolkit"
}

// =====================================================================
// OUTPUTS  (machine: ri-t-0931 — ultrawide HDMI-A-1 + laptop eDP-1)
//
// variable-refresh-rate = VRR / FreeSync / G-Sync (replaces vrr=1)
//
// For laptop-only: comment out the HDMI-A-1 block and the HDMI-A-1
// workspace blocks below; uncomment the eDP-1-only workspace set.
// For office (DP-3): swap in the DP-3 block.
// =====================================================================
output "HDMI-A-1" {
    mode "3440x1440@100.004"
    position x=0 y=0
    scale 1.0
    variable-refresh-rate
}

output "eDP-1" {
    mode "1920x1200@60.026"
    position x=3440 y=0
    scale 1.07
    variable-refresh-rate
}

// Office monitor (uncomment and comment out the two above when at office):
// output "DP-3" {
//     mode "3440x1440@60"
//     position x=0 y=0
//     scale 1.0
//     variable-refresh-rate
// }

// =====================================================================
// NAMED WORKSPACES
// In niri each output has its own independent workspace stack.
// Named workspaces are persistent and pinned to their output.
// Mod+1-9 targets the Nth workspace on the currently focused output.
// =====================================================================

// --- Primary monitor (HDMI-A-1) ---
workspace "term" {
    open-on-output "HDMI-A-1"
}
workspace "web" {
    open-on-output "HDMI-A-1"
}
workspace "code" {
    open-on-output "HDMI-A-1"
}
workspace "files" {
    open-on-output "HDMI-A-1"
}
workspace "chat" {
    open-on-output "HDMI-A-1"
}
workspace "media" {
    open-on-output "HDMI-A-1"
}
workspace "misc" {
    open-on-output "HDMI-A-1"
}
workspace "misc2" {
    open-on-output "HDMI-A-1"
}

// --- Laptop panel (eDP-1) — Slack fullscreen ---
workspace "slack" {
    open-on-output "eDP-1"
}

// Laptop-only set (swap with the HDMI-A-1 blocks above):
// workspace "term"  { open-on-output "eDP-1" }
// workspace "web"   { open-on-output "eDP-1" }
// workspace "code"  { open-on-output "eDP-1" }
// workspace "files" { open-on-output "eDP-1" }
// workspace "chat"  { open-on-output "eDP-1" }
// workspace "media" { open-on-output "eDP-1" }
// workspace "misc"  { open-on-output "eDP-1" }
// workspace "misc2" { open-on-output "eDP-1" }
// workspace "slack" { open-on-output "eDP-1" }

// =====================================================================
// INPUT
// =====================================================================
input {
    keyboard {
        xkb {
            layout "us"
            // variant ""
            // options "caps:escape"
        }
        repeat-delay 300
        repeat-rate 50
        numlock
    }

    mouse {
        accel-speed 0.0
        accel-profile "flat"
    }

    touchpad {
        tap
        natural-scroll
        scroll-factor 0.8
        click-method "clickfinger"    // 2-finger = right-click, 3-finger = middle
    }

    // Focus follows hover (Hyprland: follow_mouse=1)
    focus-follows-mouse max-scroll-amount="0%"

    // warp-mouse-to-focus   // disabled — Hyprland also had this off
}

// =====================================================================
// LAYOUT
// niri is inherently scrollable-tiling (like your Hyprland scrolling
// layout but for every workspace). Windows live in columns that scroll
// horizontally. Multiple windows can share a column (stacked).
//
// gaps: single value for both inter-window and edge spacing.
//       Hyprland had gaps_in=4, gaps_out=8 → 8 is a fair midpoint.
// =====================================================================
layout {
    gaps 8

    // "never" = scroll to focused column rather than centering it
    center-focused-column "never"

    // Widths cycled by Mod+R
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    default-column-width { proportion 0.5; }

    // Focus ring drawn outside window geometry — equivalent to
    // Hyprland's col.active_border gradient (b4a7d6 → 8a7fc7 @ 45°)
    focus-ring {
        on
        width 2
        active-gradient from="#b4a7d6" to="#8a7fc7" angle=45
        inactive-color "#3a3a5c"
    }

    border {
        off
    }

    // Shadows (Hyprland: range=4, render_power=3, color=rgba(1a1a1aee))
    shadow {
        on
        softness 10
        spread 2
        offset x=0 y=2
        draw-behind-window true
        color "#1a1a1aee"
    }

    // Struts: Noctalia's bar uses layer-shell reserved areas automatically.
    // Only override here if the bar stops reserving space correctly.
    struts {
        // top 40
    }
}

// =====================================================================
// ANIMATIONS
// niri supports easing curves and spring animations.
// Springs are preferred for touchpad gestures (more tactile feel).
//
// Hyprland → niri mapping:
//   snap     (0.19, 1.0, 0.22, 1.0)   ≈ ease-out-expo
//   smooth   (0.25, 0.1, 0.25, 1.0)   ≈ ease-out
//   overshoot (0.05, 0.9, 0.1, 1.05)  ≈ spring damping-ratio=0.85
// =====================================================================
animations {
    // Window open  (Hyprland: windows snap slide)
    window-open {
        duration-ms 250
        curve "ease-out-expo"
    }

    // Window close  (Hyprland: windowsOut smooth popin 80%)
    window-close {
        duration-ms 200
        curve "ease-out"
    }

    // Window move/resize  (Hyprland: windowsMove snap)
    window-movement {
        duration-ms 250
        curve "ease-out-expo"
    }

    window-resize {
        duration-ms 250
        curve "ease-out-expo"
    }

    // Horizontal column scroll  (Hyprland: workspaces overshoot slide)
    // Spring gives the slight bounce the overshoot bezier produced.
    horizontal-view-movement {
        spring damping-ratio=0.85 stiffness=1000 epsilon=0.0001
    }

    // Workspace switch
    workspace-switch {
        spring damping-ratio=0.85 stiffness=1000 epsilon=0.0001
    }

    // Noctalia layer slide  (Hyprland: layers smooth slide top)
    config-notification-open-close {
        duration-ms 300
        curve "ease-out"
    }
}

// =====================================================================
// WINDOW RULES
// match: app-id and title support Rust regex (r#"..."# syntax).
// =====================================================================

// --- Rounded corners (Hyprland: rounding=4, rounding_power=2) ---
window-rule {
    geometry-corner-radius 4
    clip-to-geometry true
}

// --- Ghostty terminal: 95% opacity ---
window-rule {
    match app-id=r#"^com\.mitchellh\.ghostty$"#
    opacity 0.95
}

// --- KDE apps: 95% opacity ---
window-rule {
    match app-id=r#"^org\.kde\..+"#
    opacity 0.95
}

// --- Nemo file manager: 95% opacity ---
window-rule {
    match app-id="^nemo$"
    opacity 0.95
}

// --- File Roller archive manager ---
window-rule {
    match app-id=r#"^org\.gnome\.FileRoller$"#
    opacity 0.95
    open-floating true
}

// --- GNOME Calculator ---
window-rule {
    match app-id=r#"^org\.gnome\.Calculator$"#
    opacity 0.95
    open-floating true
}

// --- virt-manager: opens on chat workspace ---
window-rule {
    match app-id="^virt-manager$"
    opacity 0.95
    open-on-workspace "chat"
}

// --- pavucontrol: floating 800×600 ---
window-rule {
    match app-id=r#"^org\.pulseaudio\.pavucontrol$"#
    open-floating true
    default-floating-size { width 800; height 600; }
}

// --- KCalc: floating ---
window-rule {
    match app-id=r#"^org\.kde\.kcalc$"#
    open-floating true
}

// --- File picker dialogs: floating ---
window-rule {
    match title="^Open File$"
    open-floating true
}
window-rule {
    match title="^Save As$"
    open-floating true
}
window-rule {
    match title="^Save File$"
    open-floating true
}

// --- Picture-in-Picture: floating, always-on-top, 480×270 ---
window-rule {
    match title="^Picture-in-Picture$"
    open-floating true
    default-floating-size { width 480; height 270; }
}

// --- Slack: fullscreen on eDP-1 ---
window-rule {
    match app-id="^slack$"
    open-on-workspace "slack"
    open-fullscreen true
}

// --- App workspace assignments ---
window-rule {
    match app-id=r#"^zen.*"#
    open-on-workspace "web"
}
window-rule {
    match app-id="^obsidian$"
    open-on-workspace "term"
}
window-rule {
    match app-id="^code(-url-handler)?$"
    open-on-workspace "code"
}
window-rule {
    match app-id="^firefox$"
    open-on-workspace "files"
}

// --- Age of Empires II: floating, 1920×1200, no window decorations ---
window-rule {
    match app-id=r#"^steam_app_813780$"#
    open-floating true
    default-floating-size { width 1920; height 1200; }
}

// =====================================================================
// SPAWN AT STARTUP
// Replaces Hyprland's exec-once. Runs once per compositor session.
//
// Noctalia / Quickshell note:
//   The IPC keybinds (Mod+Space, Mod+L, etc.) use Quickshell's own IPC
//   and are compositor-agnostic — they WILL work on niri.
//   The workspace widget and active-window display inside Noctalia use
//   Hyprland IPC internally; these may not update correctly until
//   Noctalia ships niri backend support. Watch the Noctalia upstream.
// =====================================================================
spawn-at-startup "dbus-update-activation-environment" "--systemd" "--all"
spawn-at-startup "systemctl" "--user" "import-environment" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP" "XDG_SESSION_TYPE" "XDG_SESSION_DESKTOP"
spawn-at-startup "sh" "-c" "/home/naeem/.config/hypr/import-gsettings.sh"
spawn-at-startup "powerprofilesctl" "set" "balanced"
spawn-at-startup "wl-paste" "--type" "text" "--watch" "cliphist" "store"
spawn-at-startup "wl-paste" "--type" "image" "--watch" "cliphist" "store"
spawn-at-startup "hypridle"
spawn-at-startup "slack"
spawn-at-startup "seafile-applet"
spawn-at-startup "obsidian"
spawn-at-startup "arch-update" "--tray"
spawn-at-startup "/usr/lib/kdeconnectd"
spawn-at-startup "/usr/bin/kdeconnect-indicator"
spawn-at-startup "qs" "-c" "noctalia-shell" "--no-duplicate"

// =====================================================================
// KEY BINDINGS
// =====================================================================
binds {
    // -----------------------------------------------------------------
    // NOCTALIA IPC
    // All of these call Quickshell's own IPC — compositor-agnostic.
    // -----------------------------------------------------------------
    Mod+Space       { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "launcher" "toggle"; }
    Mod+Shift+W     { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "launcher" "windows"; }
    Mod+Shift+E     { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "launcher" "emoji"; }
    Mod+B           { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "launcher" "clipboard"; }
    Mod+Shift+Comma { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "settings" "toggle"; }
    Mod+C           { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "calendar" "toggle"; }
    Mod+T           { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "controlCenter" "toggle"; }
    Mod+N           { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "controlCenter" "toggle"; }
    Mod+L           { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "lockScreen" "lock"; }
    Ctrl+Alt+P      { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "sessionMenu" "toggle"; }
    Ctrl+Alt+D      { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "notifications" "toggleDND"; }
    Mod+Shift+P     { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "mediaControls" "toggle"; }

    // -----------------------------------------------------------------
    // ESSENTIAL
    // -----------------------------------------------------------------
    Mod+Return  { spawn "ghostty"; }
    Mod+E       { spawn "nemo"; }
    Mod+Q cooldown-ms=500 { close-window; }
    Mod+Shift+R { reconfigure; }    // replaces: hyprctl reload

    // -----------------------------------------------------------------
    // WINDOW FOCUS
    // In niri: Left/Right = between columns, Up/Down = within a column.
    //
    // Mod+L is reserved for lockScreen above.
    // Use Mod+Right arrow for vim-style "right" focus instead.
    // -----------------------------------------------------------------
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+H     { focus-column-left; }
    // Mod+L → lockScreen (see Noctalia IPC section)
    Mod+K     { focus-window-up; }
    Mod+J     { focus-window-down; }

    // -----------------------------------------------------------------
    // WINDOW MOVEMENT
    // -----------------------------------------------------------------
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+L     { move-column-right; }
    Mod+Shift+K     { move-window-up; }
    Mod+Shift+J     { move-window-down; }

    // -----------------------------------------------------------------
    // WINDOW RESIZE
    // Hyprland used 30px steps; niri uses percentage of monitor width.
    // -----------------------------------------------------------------
    Mod+Alt+Right { set-column-width "+5%"; }
    Mod+Alt+Left  { set-column-width "-5%"; }
    Mod+Alt+Down  { set-window-height "+5%"; }
    Mod+Alt+Up    { set-window-height "-5%"; }

    // -----------------------------------------------------------------
    // WINDOW STATES
    // Mod+P repurposed from "pseudo" (dwindle-only) to expel-from-column
    // which is the closest niri equivalent (move window out of a stack).
    // -----------------------------------------------------------------
    Mod+F       { toggle-window-floating; }
    Mod+Shift+F { fullscreen-window; }
    Mod+M       { maximize-column; }
    Mod+R       { switch-preset-column-width; }  // cycle preset widths
    Mod+P       { expel-window-from-column; }    // break window out of column stack
    Mod+Shift+J { consume-window-into-column; }  // pull window into column below/above

    // -----------------------------------------------------------------
    // WORKSPACES
    // -----------------------------------------------------------------
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }
    Mod+Shift+6 { move-window-to-workspace 6; }
    Mod+Shift+7 { move-window-to-workspace 7; }
    Mod+Shift+8 { move-window-to-workspace 8; }
    Mod+Shift+9 { move-window-to-workspace 9; }
    Mod+Shift+0 { move-window-to-workspace 10; }

    Mod+Tab       { focus-workspace-down; }
    Mod+Shift+Tab { focus-workspace-up; }

    // Move active workspace to another monitor (niri bonus)
    Mod+Shift+U { move-workspace-to-monitor-left; }
    Mod+Shift+I { move-workspace-to-monitor-right; }

    // -----------------------------------------------------------------
    // MOUSE BINDINGS
    // Hold Mod + left-click drag = move floating window
    // Hold Mod + right-click drag = resize floating window
    // -----------------------------------------------------------------
    Mod+MouseLeft  { move-window-with-pointer; }
    Mod+MouseRight { resize-window-with-pointer; }

    // Scroll workspaces with mouse wheel while holding Mod
    Mod+WheelScrollDown { focus-workspace-down; }
    Mod+WheelScrollUp   { focus-workspace-up; }

    // -----------------------------------------------------------------
    // SCREENSHOTS
    // niri has a built-in screenshot UI — replaces hyprshot.
    // Screenshots save to XDG_PICTURES_DIR by default.
    // -----------------------------------------------------------------
    Print           { screenshot; }
    Mod+Print       { screenshot-screen; }
    Mod+Shift+Print { screenshot-window; }

    // -----------------------------------------------------------------
    // MEDIA KEYS
    // allow-when-locked=true: keys work on the lock screen.
    // -----------------------------------------------------------------
    XF86AudioRaiseVolume  allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.5" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute         allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute      allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "set" "+5%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }
    XF86AudioPlay         allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext         allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev         allow-when-locked=true { spawn "playerctl" "previous"; }
}
