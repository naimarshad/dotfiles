binds {
    // --- Noctalia IPC (v5 `noctalia msg`) ---
    Mod+Space       { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+Shift+W     { spawn "noctalia" "msg" "window-switcher"; }
    Mod+Shift+E     { spawn "noctalia" "msg" "panel-toggle" "launcher" "/emo"; }
    Mod+B           { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }
    Mod+Shift+Comma { spawn "noctalia" "msg" "settings-toggle"; }
    Mod+C           { spawn "noctalia" "msg" "panel-toggle" "control-center" "calendar"; }
    Mod+T           { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Mod+N           { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Mod+L           { spawn "noctalia" "msg" "session" "lock"; }
    Ctrl+Alt+P      { spawn "noctalia" "msg" "panel-toggle" "session"; }
    Ctrl+Alt+D      { spawn "noctalia" "msg" "notification-dnd-toggle"; }
    Mod+Shift+P     { spawn "noctalia" "msg" "panel-toggle" "control-center" "media"; }

    // --- Essential ---
    Mod+Return        { spawn "ghostty"; }
    Mod+E             { spawn "nautilus"; }
    Mod+Q cooldown-ms=500 { close-window; }
    Mod+Shift+R       { spawn "niri" "msg" "action" "load-config-file"; }
    Mod+Slash         { show-hotkey-overlay; }
    Mod+Shift+Escape  { quit skip-confirmation=true; }
    Mod+O             { toggle-overview; }

    // --- Focus (Mod+L reserved for lockScreen) ---
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+H     { focus-column-left; }
    Mod+K     { focus-window-up; }
    Mod+J     { focus-window-down; }

    // --- Move ---
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+L     { move-column-right; }
    Mod+Shift+K     { move-window-up; }
    Mod+Shift+J     { move-window-down; }

    // --- Resize ---
    Mod+Alt+Right { set-column-width "+5%"; }
    Mod+Alt+Left  { set-column-width "-5%"; }
    Mod+Alt+Down  { set-window-height "+5%"; }
    Mod+Alt+Up    { set-window-height "-5%"; }

    // --- Window state ---
    Mod+F             { toggle-window-floating; }
    Mod+Shift+F       { fullscreen-window; }
    Mod+M             { maximize-column; }
    Mod+R             { switch-preset-column-width; }
    Mod+P             { expel-window-from-column; }
    Mod+Period        { consume-window-into-column; }
    Mod+BracketLeft   { consume-or-expel-window-left; }
    Mod+BracketRight  { consume-or-expel-window-right; }
    Mod+Grave         { switch-focus-between-floating-and-tiling; }

    // --- Workspaces ---
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }
    Mod+Shift+6 { move-window-to-workspace 6; }
    Mod+Shift+7 { move-window-to-workspace 7; }
    Mod+Shift+8 { move-window-to-workspace 8; }
    Mod+Shift+9 { move-window-to-workspace 9; }
    Mod+Shift+0 { move-window-to-workspace 10; }

    Mod+Tab         { focus-workspace-down; }
    Mod+Shift+Tab   { focus-workspace-up; }
    Mod+Ctrl+Down   { move-column-to-workspace-down; }
    Mod+Ctrl+Up     { move-column-to-workspace-up; }
    Mod+Shift+U     { move-workspace-to-monitor-left; }
    Mod+Shift+I     { move-workspace-to-monitor-right; }

    Mod+WheelScrollDown { focus-workspace-down; }
    Mod+WheelScrollUp   { focus-workspace-up; }

    // --- Screenshots ---
    Print           { screenshot; }
    Mod+Print       { screenshot-screen; }
    Mod+Shift+Print { screenshot-window; }

    // --- Media keys ---
    XF86AudioRaiseVolume  allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.5" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute         allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute      allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "set" "+5%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }
    XF86AudioPlay         allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext         allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev         allow-when-locked=true { spawn "playerctl" "previous"; }
}
