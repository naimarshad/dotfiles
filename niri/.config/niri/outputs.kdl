// OUTPUTS — ri-t-0931
// Home layout:   [HDMI-A-1 LG ultrawide] [DP-1 MSI] [eDP-1 built-in], all landscape
// Office layout: [eDP-1 built-in] [DP-3/DP-5 P34w-20 ultrawide]
//
// Primary: LG ultrawide. Its preferred mode is already 99.997, but state it
// explicitly so a silent fallback to a slower mode would be visible.
// No variable-refresh-rate line: this panel reports VRR as unsupported.
output "HDMI-A-1" {
    mode "3440x1440@99.997"
    position x=0 y=0
    scale 1.0
}

// Secondary: MSI MP275QPG, landscape.
output "DP-1" {
    mode "2560x1440@59.951"
    position x=3440 y=0
    scale 1.0
}

// Built-in laptop monitor
output "eDP-1" {
    mode "1920x1200@60.026"
    position x=6000 y=240
    scale 1.25
    variable-refresh-rate
}

output "DP-3" {
    mode "3440x1440@59.973"
    position x=7536 y=0
    scale 1.0
}

output "DP-5" {
    mode "3440x1440@59.973"
    position x=2560 y=0
    scale 1.0
}

// WORKSPACES

// --- Primary monitor (HDMI-A-1, LG ultrawide) ---
workspace "work"     { open-on-output "HDMI-A-1"; }
workspace "web"      { open-on-output "HDMI-A-1"; }
workspace "personal" { open-on-output "HDMI-A-1"; }
workspace "files"    { open-on-output "HDMI-A-1"; }
workspace "media"    { open-on-output "HDMI-A-1"; }
workspace "misc"     { open-on-output "HDMI-A-1"; }
workspace "misc2"    { open-on-output "HDMI-A-1"; }

// --- Side monitor (DP-1, MSI): Zen + Thunderbird + Obsidian pinned here
workspace "comm"   { open-on-output "DP-1"; }

// --- Built-in laptop panel (eDP-1) ---
workspace "laptop"   { open-on-output "eDP-1"; }
